# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_AUDIO_SUBJECT=audio.frames
NATS_WHISPER_SUBJECT=whisper.transcription
NATS_LOGS_SUBJECT=whisper.logs

# Whisper Model
WHISPER_MODEL=models/whisper-medium-ru-fine-ct2
WHISPER_GGML_MODEL=models/ggml-medium.bin
LOG_LEVEL=INFO

# Audio Buffer Settings
MAX_BUFFER_DURATION=60.0  # Максимальный размер буфера перед принудительной обработкой
SAVE_RECORDINGS=true
RECORDINGS_DIR=recordings

# Silero VAD Settings
VAD_SAMPLE_RATE=16000                    # Частота для VAD (8000 или 16000)
VAD_MIN_SPEECH_DURATION_MS=250           # Минимальная длительность речи (мс)
VAD_MIN_SILENCE_DURATION_MS=300          # Минимальная пауза для конца фразы (мс)
VAD_MAX_SPEECH_DURATION_S=30.0           # Максимальная длительность фразы (сек)
VAD_SPEECH_PAD_MS=30                     # Отступ до/после речи (мс)
VAD_THRESHOLD=0.5                        # Порог VAD (0.0-1.0), меньше = чувствительнее
VAD_BUFFER_CHECK_INTERVAL=1.0            # Как часто проверять буфер (сек)
