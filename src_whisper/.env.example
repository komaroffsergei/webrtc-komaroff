# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_AUDIO_SUBJECT=audio.frames
NATS_WHISPER_SUBJECT=whisper.transcription
NATS_LOGS_SUBJECT=whisper.logs

# Whisper Model Configuration
# Вариант 1: Использовать короткое имя модели (автозагрузка из HuggingFace)
WHISPER_MODEL_NAME=medium
# MODELS_DIR=./models  # Local dev (default)
# MODELS_DIR=/app/models  # Docker (default)

# Вариант 2: Использовать прямой путь к модели (кастомная модель)
# WHISPER_MODEL=/path/to/custom/model

# Recording Configuration
SAVE_RECORDINGS=true
RECORDINGS_DIR=recordings

# Logging
LOG_LEVEL=INFO

# Silero VAD Settings
VAD_SAMPLE_RATE=16000
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=300
VAD_MAX_SPEECH_DURATION_S=30.0
VAD_SPEECH_PAD_MS=30
VAD_THRESHOLD=0.5
VAD_BUFFER_CHECK_INTERVAL=1.0
