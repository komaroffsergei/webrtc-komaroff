USER_ID=user123
NATS_URL=nats://localhost:4222
NATS_AGENT_SUBJECT=nats.agent.
NATS_AGENT_HISTORY_SUBJECT=nats.agent.history.
NATS_EVENTS_SUBJECT=nats.events.
NATS_WORKFLOW_RUN_SUBJECT=nats.workflow.run.python
# Local Docker switch lives in docker/.env.
# Ruby runtime example:
# NATS_WORKFLOW_RUN_SUBJECT=nats.workflow.run.ruby
# AsyncGraph Ruby runtime example:
# NATS_WORKFLOW_RUN_SUBJECT=nats.workflow.run.ruby.node
STACK_SERVICE_NAME=src_agent
WORKFLOW_TIMEOUT_SECONDS=60
WORKFLOW_NO_RESPONDERS_RETRIES=4
WORKFLOW_NO_RESPONDERS_RETRY_DELAY_SECONDS=1.0
RUNTIME_CONFLICT_RETRIES=3

# Database connection
DATABASE_URL=postgresql://login:pass@localhost:5432/db
