# ------------------------------
# ОБЩИЕ НАСТРОЙКИ СЕРВИСА
# ------------------------------
STACK_SERVICE_NAME=src_agent


# ------------------------------
# NATS
# ------------------------------
NATS_URL=nats://localhost:4222

# Агент принимает входящие запросы от src_core
AGENT_FRAMES_SUBJECT=agent.frames

# Агент пишет диагностические логи в отдельный сабжект
AGENT_LOGS_SUBJECT=agent.logs

# LLM сервис, которому агент шлет RPC для генерации текста
LLM_FRAMES_SUBJECT=llm.frames

# Максимальное количество токенов, отдаваемых LLM на один шаг
AGENT_MAX_TOKENS=8192


# ------------------------------
# MCP GATEWAY
# ------------------------------
# Адрес MCP Gateway (src_mcp_gateway)
MCP_HOST=127.0.0.1
MCP_PORT=6006

# FastMCP требует /mcp на конце
MCP_URL=http://src_mcp_gateway:6006/mcp


# ------------------------------
# ЛОГИРОВАНИЕ
# ------------------------------
LOG_LEVEL=info
