# frozen_string_literal: true

require "rake"
require "rbconfig"

LIB_ROOT = File.expand_path("lib", __dir__)
PROJECT_ROOT = File.expand_path(__dir__)

task default: :check

desc "Validate Ruby syntax for project files"
task :syntax do
  ruby = RbConfig.ruby
  files = Dir[
    File.join(PROJECT_ROOT, "Rakefile"),
    File.join(PROJECT_ROOT, "bin", "*"),
    File.join(PROJECT_ROOT, "lib", "**", "*.rb"),
    File.join(PROJECT_ROOT, "spec", "**", "*.rb")
  ].sort

  files.each do |file|
    sh ruby, "-cw", file
  end
end

desc "Run smoke check for the built-in catalog and adapter plan"
task :smoke do
  ruby = RbConfig.ruby
  code = <<~RUBY
    $LOAD_PATH.unshift(File.expand_path("lib", __dir__))
    require "src_langgraph_rb"

    catalog = SrcLanggraphRb.built_in_catalog
    scenario = catalog.fetch("free_speech@2.0.0")
    plan = catalog.to_builder_plan(scenario.id)
    graph = plan.build_graph

    abort("unexpected graph state") unless graph.nodes.key?(:prepare_context)
    abort("graph should stay uncompiled") if graph.compiled?

    puts({
      scenarios: catalog.all.map(&:id),
      graph_nodes: graph.nodes.keys.map(&:to_s).sort
    }.inspect)
  RUBY

  sh ruby, "-e", code, chdir: PROJECT_ROOT
end

desc "Run RSpec suite"
task :spec do
  sh "bundle", "exec", "rspec", chdir: PROJECT_ROOT
end

desc "Run all local quality checks"
task check: %i[syntax smoke spec]
