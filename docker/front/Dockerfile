FROM node:22.8.0-alpine3.19 AS build

ARG VITE_NATS_URL
ARG VITE_NATS_EVENTS_SUBJECT
ARG VITE_NATS_AGENT_SUBJECT
ARG VITE_NATS_CLIENT_NAME
ARG VITE_CORE_ORIGIN
ARG CORE_ORIGIN
ARG CI_PIPELINE_ID

WORKDIR /app
COPY package.json package-lock.json /app/
RUN npm ci
COPY . /app/

ENV COM_GITLAB_CI_PIPELINE_IID=$CI_PIPELINE_ID \
    VITE_NATS_URL=$VITE_NATS_URL \
    VITE_NATS_EVENTS_SUBJECT=$VITE_NATS_EVENTS_SUBJECT \
    VITE_NATS_AGENT_SUBJECT=$VITE_NATS_AGENT_SUBJECT \
    VITE_NATS_CLIENT_NAME=$VITE_NATS_CLIENT_NAME \
    VITE_CORE_ORIGIN=$VITE_CORE_ORIGIN \
    CORE_ORIGIN=$CORE_ORIGIN \
    FRONT_NATS_URL=$VITE_NATS_URL \
    FRONT_NATS_EVENTS_SUBJECT=$VITE_NATS_EVENTS_SUBJECT \
    FRONT_NATS_AGENT_SUBJECT=$VITE_NATS_AGENT_SUBJECT \
    FRONT_NATS_CLIENT_NAME=$VITE_NATS_CLIENT_NAME \
    FRONT_CORE_ORIGIN=$VITE_CORE_ORIGIN
RUN npm run build

FROM docker-io.monitorsoft.ru/nginx:1.20-alpine as deploy
ARG VITE_NATS_URL
ARG VITE_NATS_EVENTS_SUBJECT
ARG VITE_NATS_AGENT_SUBJECT
ARG VITE_NATS_CLIENT_NAME
ARG VITE_CORE_ORIGIN
ARG CORE_ORIGIN
ARG CI_PIPELINE_ID
ENV VITE_NATS_URL=$VITE_NATS_URL \
    VITE_NATS_EVENTS_SUBJECT=$VITE_NATS_EVENTS_SUBJECT \
    VITE_NATS_AGENT_SUBJECT=$VITE_NATS_AGENT_SUBJECT \
    VITE_NATS_CLIENT_NAME=$VITE_NATS_CLIENT_NAME \
    VITE_CORE_ORIGIN=$VITE_CORE_ORIGIN \
    CORE_ORIGIN=$CORE_ORIGIN \
    FRONT_NATS_URL=$VITE_NATS_URL \
    FRONT_NATS_EVENTS_SUBJECT=$VITE_NATS_EVENTS_SUBJECT \
    FRONT_NATS_AGENT_SUBJECT=$VITE_NATS_AGENT_SUBJECT \
    FRONT_NATS_CLIENT_NAME=$VITE_NATS_CLIENT_NAME \
    FRONT_CORE_ORIGIN=$VITE_CORE_ORIGIN \
    COM_GITLAB_CI_PIPELINE_IID=$CI_PIPELINE_ID
RUN rm -rf /usr/share/nginx/html/*
RUN rm -f /etc/nginx/conf.d/*.conf /etc/nginx/templates/*.conf.template /etc/nginx/sites-enabled/*.conf

COPY --from=build /app/dist /usr/share/nginx/html

COPY --from=nginx /default.conf /etc/nginx/templates/default.conf.template
COPY --from=nginx /nginx.conf /etc/nginx/nginx.conf
COPY --from=nginx /50-settings.sh /docker-entrypoint.d/50-settings.sh
RUN chmod +x /docker-entrypoint.d/50-settings.sh

CMD ["nginx", "-g", "daemon off;"]

