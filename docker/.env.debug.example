INSTALL_DEBUGPY=1
DEBUG_NATS_URL=nats://nats:4222
PYCHARM_DEBUG_HOST=host.docker.internal
# Absolute host path to repository root for reliable breakpoint mapping, e.g.
# PYCHARM_PROJECT_ROOT=/home/komaroff/dev/monitorsoft/voice-chat/webrtc-komaroff
PYCHARM_PROJECT_ROOT=
PYCHARM_REDIRECT_OUTPUT=0
PYCHARM_RETRY_SECONDS=2
PYCHARM_ATTACH_TIMEOUT_SECONDS=180
# Keep 0 for stable single-process attach. Set 1 only if you really need
# debugger auto-attach in child processes spawned via multiprocessing.
PYCHARM_PATCH_MULTIPROCESSING=0
DEBUGPY_WAIT_FOR_CLIENT=0
CORE_DEBUG_PORT=5671
AGENT_DEBUG_PORT=5672
API_GATEWAY_DEBUG_PORT=5673
LANGGRAPH_DEBUG_PORT=5674
LLM_DEBUG_PORT=5675
