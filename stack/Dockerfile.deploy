# FROM ruby:3.3.0-alpine3.19 as base
FROM ruby:3.4.4-slim-bookworm AS base

RUN gem install build-labels:0.0.74 dry-stack:0.1.53
RUN install-docker-static

# RUN apk add --no-cache openssh-client ca-certificates

WORKDIR /build
RUN mkdir -p /root/.ssh && mkdir -pv /root/.ssh/sockets
RUN printf '%s\n' \
'Host *' \
'  ControlPersist yes' \
'  ControlMaster auto' \
'  ControlPath /root/.ssh/sockets/%r@%h-%p' \
'  BatchMode yes' \
'  StrictHostKeyChecking no' \
'  Port 22' \
> /root/.ssh/config
ADD . .

CMD ["sh", "-c", "\
    cat webrtc.drs  | dry-stack swarm_deploy --tls-domain=gis-master.ru -x ssh://gis-master.ru -- --prune \n\
"]
