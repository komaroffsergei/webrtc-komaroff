Options name: 'web-rtc-komaroff'

NATS_USER = 'nats'
NATS_PASS = 'T0pS3cr3tMaster'
NATS_URL  = "nats://#{NATS_USER}:#{NATS_PASS}@web-rtc-komaroff_audio_nats:4222"

USER_ID = "user123"
NATS_EVENTS_SUBJECT = "nats.events."
NATS_AGENT_SUBJECT = "nats.agent."
NATS_LLM_SUBJECT = "nats.llm."
ASR_IN_PREFIX = "inference.whisper.stream."
ASR_OUT_PREFIX = "inference.whisper.text."

HOST = 'webrtc-komaroff.*'
VOICE_CHAT_HOST = 'voice-chat.*'
POSTGRES_HOST = 'web-rtc-komaroff_src_postgres'
POSTGRES_PORT = '5432'
POSTGRES_DB = 'mcp'
POSTGRES_USER = 'mcp'
POSTGRES_PASSWORD = 'mcp_pass'
DATABASE_URL = "postgresql://#{POSTGRES_USER}:#{POSTGRES_PASSWORD}@#{POSTGRES_HOST}:#{POSTGRES_PORT}/#{POSTGRES_DB}?sslmode=disable"
NATS_TOOLS_PREFIX = 'nats.tools.'
NATS_REQUEST_TIMEOUT = '600'
AGENT_MAX_STEPS = '10'
MAX_STEPS = '10'
TIMEOUT_SECONDS = '600'
WORKFLOW_RUNTIME = ENV.fetch('WORKFLOW_RUNTIME', 'ruby_node')
NATS_WORKFLOW_RUN_SUBJECT =
  case WORKFLOW_RUNTIME
  when 'ruby'
    'nats.workflow.run.ruby'
  when 'ruby_node'
    'nats.workflow.run.ruby.node'
  else
    'nats.workflow.run.python'
  end
NATS_WORKFLOW_HEALTH_SUBJECT =
  case WORKFLOW_RUNTIME
  when 'ruby'
    'nats.workflow.health.ruby'
  when 'ruby_node'
    'nats.workflow.health.ruby.node'
  else
    'nats.workflow.health.python'
  end
webrtc_registry = ->(img){ "builder-registry.builder.giscloud.ru/gis/webrtc-komaroff/#{img}/main" }
registry =->(image) { "builder-registry.builder.giscloud.ru/#{image}" }

