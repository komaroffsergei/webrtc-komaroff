Options name: 'web-rtc-komaroff'

NATS_URL = "nats://web-rtc-komaroff_audio_nats:4222"
USER_ID = ENV.fetch("USER_ID", "user123")
NATS_EVENTS_SUBJECT = ENV.fetch("NATS_EVENTS_SUBJECT", "nats.events.")
NATS_AGENT_SUBJECT = ENV.fetch("NATS_AGENT_SUBJECT", "nats.agent.")
NATS_ASR_SUBJECT = ENV.fetch("NATS_ASR_SUBJECT", "nats.asr.")

HOST = 'webrtc-komaroff.*'
webrtc_registry = ->(img){ "builder-registry.builder.giscloud.ru/gis/webrtc-komaroff/#{img}/main" }

PublishPorts core: [
  { target: 19303, published: 19303, protocol: 'udp', mode: 'host' }
]

Service :src_core, image: webrtc_registry['core']do
  ingress host: HOST, path: '/core', port: 8000

  env NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      NATS_AGENT_SUBJECT: NATS_AGENT_SUBJECT,
      NATS_ASR_SUBJECT: NATS_ASR_SUBJECT,
      STACK_SERVICE_NAME: 'src_core',
      USER_ID: USER_ID,
      CORE_HOST: '0.0.0.0',
      CORE_PORT: 8000,
      ASR_MODELS_DIR: '/app/models/asr',
      ASR_MODEL_ID: 'Systran/faster-whisper-small',
      VAD_MODEL_PATH: '/app/src_core/models/vad',
      VAD_MODEL_URL: 'https://github.com/snakers4/silero-vad/raw/refs/heads/master/src/silero_vad/data/silero_vad.onnx'
  volume name: 'ASR_MODELS_DIR', target: '/app/models/asr'
  volume name: 'VAD_MODELS_PATH', target: '/app/src_core/models/vad'
end

Service :src_api_gateway, image: webrtc_registry['api-gateway']do
  ingress host: HOST, path: '/api', port: 8100

  env API_HOST: '0.0.0.0',
      API_PORT: 8100
end

Service :src_agent, image: webrtc_registry['agent'] do
  env STACK_SERVICE_NAME: 'src_agent',
      USER_ID: USER_ID,
      NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      NATS_AGENT_SUBJECT: NATS_AGENT_SUBJECT,
      NATS_LLM_SUBJECT: ENV.fetch('NATS_LLM_SUBJECT', 'nats.llm.'),
      AGENT_MAX_STEPS: ENV.fetch('AGENT_MAX_STEPS', '10'),
      MAX_STEPS: ENV.fetch('MAX_STEPS', '10'),
      TIMEOUT_SECONDS: ENV.fetch('TIMEOUT_SECONDS', '60'),
      OLLAMA_URL: ENV.fetch('OLLAMA_URL', 'http://host.docker.internal:11435'),
      OLLAMA_MODEL: ENV.fetch('OLLAMA_MODEL', 'qwen3:1.7b'),
      DATABASE_URL: ENV.fetch(
        'DATABASE_URL',
        'postgresql://mcp:mcp_pass@web-rtc-komaroff_src_postgres:5432/mcp'
      ),
      AIRPORTS_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/airports/search',
      RUNWAYS_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/airports',
      PILOT_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/pilot/location',
      ROUTES_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/routes/nearest',
      WEATHER_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/weather'
end

Service :src_whisper, image: webrtc_registry['whisper'] do
  env NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      NATS_ASR_SUBJECT: NATS_ASR_SUBJECT,
      STACK_SERVICE_NAME: 'src_whisper',
      USER_ID: USER_ID,
      ASR_MODELS_DIR: '/app/models/asr',
      ASR_MODEL_ID: 'Systran/faster-whisper-small'
  volume name: 'ASR_MODELS_DIR', target: '/app/models/asr'
end

Service :src_front, image: webrtc_registry['front'] do
  ingress host: HOST, port: 8000

  env FRONT_NATS_URL: 'wss:///ws',
      FRONT_NATS_EVENTS_SUBJECT: "#{NATS_EVENTS_SUBJECT}#{USER_ID}",
      FRONT_NATS_AGENT_SUBJECT: "#{NATS_AGENT_SUBJECT}#{USER_ID}",
      FRONT_NATS_CLIENT_NAME: 'src_front',
      FRONT_CORE_ORIGIN: 'http://web-rtc-komaroff_src_core:8000',
      COM_GITLAB_CI_PIPELINE_IID: ENV['CI_PIPELINE_ID'] ||
                                 ENV['CI_PIPELINE_IID'] ||
                                 'local'
end

Service :src_postgres, image: 'postgis/postgis:16-master' do
  env POSTGRES_DB: 'mcp', POSTGRES_USER: 'mcp', POSTGRES_PASSWORD: 'mcp_pass'
  volume target: '/var/lib/postgresql/data'
  command ['postgres', '--wal_level=logical']
  ingress host_sni: "db.#{HOST}", port: 5432, entrypoints: 'postgres'
end


Service :audio_nats, image: 'nats:2.11.6-scratch' do
  ingress host: HOST, path: '/ws', path_sub: ['^/ws(.*)', '$1'], port: 9222

  command ['-c', '/nats.conf']
  config target: '/nats.conf', file_content: <<~CONF
    jetstream: false
    websocket: {
      listen: 0.0.0.0:9222
      no_tls: true
      compression: true
    }
  CONF
end

Service :nats_box, image: 'natsio/nats-box' do
  env NATS_URL: NATS_URL
  entrypoint 'sh -c "sleep infinity"'
end
