Service :py_faster_whisper, image: webrtc_registry['voice-chat/stt_whisper_to_nats'] do
  ingress host: HOST, path: '/whisper', port: 8090

  env NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      ASR_IN_PREFIX: ASR_IN_PREFIX,
      ASR_OUT_PREFIX: ASR_OUT_PREFIX,
      ASR_FILE_JOB_SUBJECT: ASR_FILE_JOB_SUBJECT,
      ASR_FILE_EVENT_PREFIX: ASR_FILE_EVENT_PREFIX,
      ASR_FILE_SESSION_EVENT_PREFIX: ASR_FILE_SESSION_EVENT_PREFIX,
      ASR_FILE_CANCEL_PREFIX: ASR_FILE_CANCEL_PREFIX,
      WEBUI_NATS_WS_URL: WEBUI_NATS_WS_URL,
      WEBUI_NATS_USER: NATS_USER,
      WEBUI_NATS_PASS: NATS_PASS,
      WEBUI_NATS_CLIENT_NAME: WEBUI_NATS_CLIENT_NAME,
      LINTO_HTTP_URL: LINTO_HTTP_URL,
      LINTO_HTTP_HOST: LINTO_HTTP_HOST,
      LINTO_HTTP_LANGUAGE: LINTO_HTTP_LANGUAGE,
      LINTO_WS_URL: LINTO_WS_URL,
      LINTO_WS_HOST: LINTO_WS_HOST,
      LINTO_WS_LANGUAGE: LINTO_WS_LANGUAGE,
      FILE_JOB_STORAGE_DIR: FILE_JOB_STORAGE_DIR,
      FILE_CHUNK_SECONDS: FILE_CHUNK_SECONDS,
      FILE_CHUNK_OVERLAP_SECONDS: FILE_CHUNK_OVERLAP_SECONDS,
      FILE_CHUNK_RETRY_LIMIT: FILE_CHUNK_RETRY_LIMIT,
      FILE_TEXT_SOFT_BREAK_S: FILE_TEXT_SOFT_BREAK_S,
      FILE_TEXT_HARD_BREAK_S: FILE_TEXT_HARD_BREAK_S,
      WHISPER_STACK_REVISION: WHISPER_STACK_REVISION,
      STREAM_BRIDGE_ENABLED: '1',
      FILE_WORKER_ENABLED: '0',
      WEBUI_FILE_TRANSCRIBE_ENABLED: '1',
      WEBUI_FILE_BACKEND: 'chunked_http_nats',
      WEBUI_FILE_DEFAULT_TAB: 'file',
      WEBUI_FILE_MAX_UPLOAD_MB: '1024',
      WEBUI_FILE_STREAM_CHUNK_MS: '500',
      WEBUI_FILE_STREAM_WAIT_MS: '50',
      WEBUI_FILE_EOF_TIMEOUT_S: '180',
      WEBUI_FILE_FINAL_IDLE_S: '2.0',
      WEBUI_FILE_MAX_CONCURRENCY: '1',
      WEBUI_BASE_PATH: "/whisper",
      STACK_SERVICE_NAME: 'stt_whisper_to_nats'

  volume name: 'whisper-file-jobs', target: FILE_JOB_STORAGE_DIR
  entrypoint 'python -m src.stt_whisper_to_nats'
end

Service :py_faster_whisper_file_worker, image: webrtc_registry['voice-chat/stt_whisper_to_nats'] do
  env NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      ASR_FILE_JOB_SUBJECT: ASR_FILE_JOB_SUBJECT,
      ASR_FILE_EVENT_PREFIX: ASR_FILE_EVENT_PREFIX,
      ASR_FILE_SESSION_EVENT_PREFIX: ASR_FILE_SESSION_EVENT_PREFIX,
      ASR_FILE_CANCEL_PREFIX: ASR_FILE_CANCEL_PREFIX,
      LINTO_HTTP_URL: LINTO_HTTP_URL,
      LINTO_HTTP_HOST: LINTO_HTTP_HOST,
      LINTO_HTTP_LANGUAGE: LINTO_HTTP_LANGUAGE,
      FILE_JOB_STORAGE_DIR: FILE_JOB_STORAGE_DIR,
      FILE_CHUNK_SECONDS: FILE_CHUNK_SECONDS,
      FILE_CHUNK_OVERLAP_SECONDS: FILE_CHUNK_OVERLAP_SECONDS,
      FILE_CHUNK_RETRY_LIMIT: FILE_CHUNK_RETRY_LIMIT,
      FILE_TEXT_SOFT_BREAK_S: FILE_TEXT_SOFT_BREAK_S,
      FILE_TEXT_HARD_BREAK_S: FILE_TEXT_HARD_BREAK_S,
      WHISPER_STACK_REVISION: WHISPER_STACK_REVISION,
      WEBUI_ENABLED: '0',
      STREAM_BRIDGE_ENABLED: '0',
      FILE_WORKER_ENABLED: '1',
      STACK_SERVICE_NAME: 'stt_whisper_file_worker'

  volume name: 'whisper-file-jobs', target: FILE_JOB_STORAGE_DIR
  entrypoint 'python -m src.stt_whisper_to_nats'
end



Service :nats_box, image: 'natsio/nats-box' do
  env NATS_URL: NATS_URL
  entrypoint 'sh -c "sleep infinity"'
end

Service :nats_ui, image: registry['nats-ui/main:latest'], ports: 7000 do
  ingress host: "ns.#{HOST}", basic_auth: 'admin:admin:i7hdbc9g'
  env NATS_URL: NATS_URL
end

Service :pgweb_mcp, image: 'sosedoff/pgweb:0.17.0', env: { PGWEB_DATABASE_URL: DATABASE_URL },
        ingress: { host: "pgweb.#{HOST}", port: 8081, basic_auth: 'admin:admin:i7123hdbc9g' }
