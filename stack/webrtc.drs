Options name: 'web-rtc-komaroff'

NATS_URL = "nats://web-rtc-komaroff_audio_nats:4222"
PublishPorts back: [ { target: 19303, published: 19303, protocol: 'udp', mode: 'host'}]
Service :back,  image: 'builder-registry.builder.giscloud.ru/webrtc-server-komaroff-back/main', ports: 8000,
        ingress: { host: 'webrtc-komaroff.*' } do
  env NATS_URL: NATS_URL,
      NATS_AUDIO_SUBJECT: 'voice_chat_audio.frames',
      NATS_WHISPER_SUBJECT: 'voice_chat_transcription',
      NATS_LOGS_SUBJECT: 'voice_chat_logs'
end

Service :whisper, image: 'builder-registry.builder.giscloud.ru/webrtc-komaroff-whisper/main', ports: 9000,
        ingress: { host: 'webrtc-komaroff-whisper.*' } do
   env NATS_URL: NATS_URL,
      NATS_AUDIO_SUBJECT: 'voice_chat_audio.frames',
      NATS_WHISPER_SUBJECT: 'voice_chat_transcription',
      NATS_LOGS_SUBJECT: 'voice_chat_logs',
      WHISPER_MODEL_NAME: 'medium',
      WHISPER_MODELS_DIR: '/app/models'
   volume name: 'wisper_models', target: '/app/server/models'
end

Service :whisper_ruby, image: 'builder-registry.builder.giscloud.ru/webrtc-komaroff-whisper-ruby/main', ports: 7000,
        ingress: { host: 'webrtc-komaroff-whisper-ruby.*' } do
   env NATS_URL: NATS_URL,
      NATS_WHISPER_SUBJECT: 'voice_chat_transcription',
      NATS_LOGS_SUBJECT: 'voice_chat_logs',
      SERVICE_NAME: 'src_whisper_ruby',
      WHISPER_MODEL_NAME: 'medium',
      WHISPER_VAD_MODEL_NAME: 'silero-v5.1.2',
      WHISPER_MODELS_DIR: '/app/models',
      PORT: 7000
   volume name: 'whisper_ruby_models', target: '/app/models'
end

Service :audio_nats, image: 'nats:2.11.6-scratch'

Service :nats_box, image: 'natsio/nats-box' do
  env NATS_URL: NATS_URL
  entrypoint "sh -c \"sleep infinity\""
end
