Options name: 'web-rtc-komaroff'

NATS_URL = "nats://web-rtc-komaroff_audio_nats:4222"
USER_ID = ENV.fetch("USER_ID", "user123")
NATS_EVENTS_SUBJECT = ENV.fetch("NATS_EVENTS_SUBJECT", "nats.events.")
NATS_AGENT_SUBJECT = ENV.fetch("NATS_AGENT_SUBJECT", "nats.agent.")
NATS_LLM_SUBJECT = ENV.fetch("NATS_LLM_SUBJECT", "nats.llm.")
ASR_IN_SUBSCRIBE = ENV.fetch("ASR_IN_SUBSCRIBE", "nats.asr.input.>")
ASR_IN_PREFIX = ENV.fetch("ASR_IN_PREFIX", "nats.asr.input.")
ASR_OUT_PREFIX = ENV.fetch("ASR_OUT_PREFIX", "nats.asr.output.")

HOST = 'webrtc-komaroff.*'
POSTGRES_HOST = ENV.fetch("POSTGRES_HOST", "web-rtc-komaroff_src_postgres")
POSTGRES_PORT = ENV.fetch("POSTGRES_PORT", "5432")
POSTGRES_DB = ENV.fetch("POSTGRES_DB", "mcp")
POSTGRES_USER = ENV.fetch("POSTGRES_USER", "mcp")
POSTGRES_PASSWORD = ENV.fetch("POSTGRES_PASSWORD", "mcp_pass")
DATABASE_URL = "postgresql://#{POSTGRES_USER}:#{POSTGRES_PASSWORD}@#{POSTGRES_HOST}:#{POSTGRES_PORT}/#{POSTGRES_DB}?sslmode=disable"
webrtc_registry = ->(img){ "builder-registry.builder.giscloud.ru/gis/webrtc-komaroff/#{img}/main" }
registry =->(image) { "builder-registry.builder.giscloud.ru/#{image}" }

PublishPorts core: [
  { target: 19303, published: 19303, protocol: 'udp', mode: 'host' }
]

Service :src_core, image: webrtc_registry['core']do
  ingress host: HOST, path: '/core', port: 8000

  env NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      NATS_AGENT_SUBJECT: NATS_AGENT_SUBJECT,
      ASR_IN_PREFIX: ASR_IN_PREFIX,
      ASR_OUT_PREFIX: ASR_OUT_PREFIX,
      API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api',
      NATS_REQUEST_TIMEOUT: ENV.fetch("NATS_REQUEST_TIMEOUT", "600"),
      STACK_SERVICE_NAME: 'src_core',
      USER_ID: USER_ID,
      CORE_HOST: '0.0.0.0',
      CORE_PORT: 8000,
      ASR_MODELS: '/app/models/asr',
      ASR_MODEL_ID: 'Systran/faster-whisper-small',
      VAD_MODEL_PATH: '/app/models/vad',
      VAD_MODEL_URL: 'https://github.com/snakers4/silero-vad/raw/refs/heads/master/src/silero_vad/data/silero_vad.onnx'
  volume name: 'ASR_MODELS', target: '/app/models/asr'
  volume name: 'VAD_MODELS_PATH', target: '/app/models/vad'
end

Service :src_api_gateway, image: webrtc_registry['api-gateway']do
  ingress host: HOST, path: '/api', port: 8100

  env API_HOST: '0.0.0.0',
      API_PORT: 8100
end

Service :src_agent, image: webrtc_registry['agent'] do
  env STACK_SERVICE_NAME: 'src_agent',
      USER_ID: USER_ID,
      NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      NATS_AGENT_SUBJECT: NATS_AGENT_SUBJECT,
      NATS_LLM_SUBJECT: NATS_LLM_SUBJECT,
      AGENT_MAX_STEPS: ENV.fetch('AGENT_MAX_STEPS', '10'),
      MAX_STEPS: ENV.fetch('MAX_STEPS', '10'),
      TIMEOUT_SECONDS: ENV.fetch('TIMEOUT_SECONDS', '600'),
      POSTGRES_HOST: POSTGRES_HOST,
      POSTGRES_PORT: POSTGRES_PORT,
      POSTGRES_DB: POSTGRES_DB,
      POSTGRES_USER: POSTGRES_USER,
      POSTGRES_PASSWORD: POSTGRES_PASSWORD,
      DATABASE_URL: ENV.fetch(
        'DATABASE_URL',
        "postgresql://#{POSTGRES_USER}:#{POSTGRES_PASSWORD}@#{POSTGRES_HOST}:#{POSTGRES_PORT}/#{POSTGRES_DB}"
      ),
      API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api',
      AIRPORTS_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/airports/search',
      RUNWAYS_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/airports',
      PILOT_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/pilot/location',
      ROUTES_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/routes/nearest',
      WEATHER_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/weather',
      FLIGHTS_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/flights/status'
end

Service :src_llm, image: webrtc_registry['llm'] do
  env STACK_SERVICE_NAME: 'src_llm',
      USER_ID: USER_ID,
      NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      NATS_LLM_SUBJECT: NATS_LLM_SUBJECT,
      OLLAMA_URL: ENV.fetch('OLLAMA_URL', 'http://ollama.h100.local'),
      LLM_MODE: ENV.fetch('LLM_MODE', 'local'),
      LLM_LOCAL_MODEL: ENV.fetch('LLM_LOCAL_MODEL', 'Qwen/Qwen3-1.7B-GGUF'),
      LLM_REMOTE_MODEL: ENV.fetch('LLM_REMOTE_MODEL', 'qwen3:1.7b'),
      LLM_MODELS: ENV.fetch('LLM_MODELS', '/app/models/llm'),
      OLLAMA_MODEL_FILE: ENV.fetch('OLLAMA_MODEL_FILE', ''),
      LLM_CONTEXT_SIZE: ENV.fetch('LLM_CONTEXT_SIZE', '8192')
  volume name: 'LLM_MODELS', target: '/app/models/llm'
end

Service :src_front, image: webrtc_registry['front'] do
  ingress host: HOST, port: 8000

  env FRONT_NATS_EVENTS_SUBJECT: "#{NATS_EVENTS_SUBJECT}#{USER_ID}",
      FRONT_NATS_AGENT_SUBJECT: "#{NATS_AGENT_SUBJECT}#{USER_ID}",
      FRONT_NATS_CLIENT_NAME: 'src_front',
      FRONT_CORE_ORIGIN: 'http://web-rtc-komaroff_src_core:8000',
      COM_GITLAB_CI_PIPELINE_IID: ENV['CI_PIPELINE_ID'] ||
                                 ENV['CI_PIPELINE_IID'] ||
                                 'local'
end

Service :src_postgres, image: webrtc_registry['postgres'] do
  env POSTGRES_DB: POSTGRES_DB,
      POSTGRES_USER: POSTGRES_USER,
      POSTGRES_PASSWORD: POSTGRES_PASSWORD

  volume target: '/var/lib/postgresql/data'

  # оставляем твой параметр
  command ['postgres', '--wal_level=logical']

  ingress host_sni: "db.#{HOST}", port: 5432, entrypoints: 'postgres'
end



Service :audio_nats, image: 'nats:2.11.6-scratch' do
  ingress host: HOST, path: '/ws', path_sub: ['^/ws(.*)', '$1'], port: 9222

  command ['-c', '/nats.conf']
  config target: '/nats.conf', file_content: <<~CONF
    jetstream: false
    websocket: {
      listen: 0.0.0.0:9222
      no_tls: true
      compression: true
    }
  CONF
end

Service :src_whisper, image: webrtc_registry['whisper'] do
  ingress host: HOST, path: '/whisper', port: 8090

  env NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      ASR_IN_SUBSCRIBE: ASR_IN_SUBSCRIBE,
      ASR_IN_PREFIX: ASR_IN_PREFIX,
      ASR_OUT_PREFIX: ASR_OUT_PREFIX,
      WEBUI_ENABLED: ENV.fetch("WEBUI_ENABLED", "1"),
      WEBUI_HOST: ENV.fetch("WEBUI_HOST", "0.0.0.0"),
      WEBUI_PORT: ENV.fetch("WEBUI_PORT", "8090"),
      WEBUI_BASE_PATH: ENV.fetch("WEBUI_BASE_PATH", "/whisper"),
      STACK_SERVICE_NAME: 'src_whisper',
      ASR_MODELS: '/app/models/asr',
      ASR_MODEL_ID: 'Systran/faster-whisper-small'
  volume name: 'ASR_MODELS', target: '/app/models/asr'
end


Service :nats_box, image: 'natsio/nats-box' do
  env NATS_URL: NATS_URL
  entrypoint 'sh -c "sleep infinity"'
end

Service :nats_ui, image: registry['nats-ui/main:latest'], ports: 7000 do
  ingress host: "ns.#{HOST}", basic_auth: 'admin:admin:i7hdbc9g'
  env NATS_URL: NATS_URL
end

Service :pgweb_mcp, image: 'sosedoff/pgweb:0.17.0', env: { PGWEB_DATABASE_URL: DATABASE_URL },
        ingress: { host: "pgweb.#{HOST}", port: 8081, basic_auth: 'admin:admin:i7123hdbc9g' }
