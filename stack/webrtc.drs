PublishPorts core: [
  { target: 19303, published: 19303, protocol: 'udp', mode: 'host' }
]

# Core backend for browser sessions: handles /core, WebRTC-facing orchestration,
# and coordinates agent / ASR requests through NATS and the API gateway.
Service :src_core, image: webrtc_registry['core']do
  ingress host: HOST, path: '/core', port: 8000

  env NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      NATS_AGENT_SUBJECT: NATS_AGENT_SUBJECT,
      ASR_IN_PREFIX: ASR_IN_PREFIX,
      ASR_OUT_PREFIX: ASR_OUT_PREFIX,
      API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api',
      NATS_REQUEST_TIMEOUT: NATS_REQUEST_TIMEOUT,
      STACK_SERVICE_NAME: 'src_core',
      USER_ID: USER_ID,
      CORE_HOST: '0.0.0.0',
      CORE_PORT: 8000
end

# Internal REST facade for domain data used by core/agent/runtime services.
Service :src_api_gateway, image: webrtc_registry['api-gateway']do
  ingress host: HOST, path: '/api', port: 8100

  env API_HOST: '0.0.0.0',
      API_PORT: 8100,
      NATS_URL: NATS_URL,
      NATS_TOOLS_PREFIX: NATS_TOOLS_PREFIX
end

# Main agent runtime: consumes agent requests from NATS and calls tools/workflows/LLM.
Service :src_agent, image: webrtc_registry['agent'] do
  env STACK_SERVICE_NAME: 'src_agent',
      USER_ID: USER_ID,
      NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      NATS_AGENT_SUBJECT: NATS_AGENT_SUBJECT,
      NATS_LLM_SUBJECT: NATS_LLM_SUBJECT,
      NATS_WORKFLOW_RUN_SUBJECT: NATS_WORKFLOW_RUN_SUBJECT,
      AGENT_MAX_STEPS: AGENT_MAX_STEPS,
      MAX_STEPS: MAX_STEPS,
      TIMEOUT_SECONDS: TIMEOUT_SECONDS,
      DATABASE_URL: DATABASE_URL,
      API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api',
      AIRPORTS_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/airports/search',
      RUNWAYS_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/airports',
      PILOT_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/pilot/location',
      ROUTES_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/routes/nearest',
      WEATHER_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/weather',
      FLIGHTS_API_URL: 'http://web-rtc-komaroff_src_api_gateway:8100/api/flights/status'
end

# LLM adapter service for the agent layer. In current config it points at remote Ollama.
Service :src_llm, image: webrtc_registry['llm'] do
  env STACK_SERVICE_NAME: 'src_llm',
      USER_ID: USER_ID,
      NATS_URL: NATS_URL,
      NATS_EVENTS_SUBJECT: NATS_EVENTS_SUBJECT,
      NATS_LLM_SUBJECT: NATS_LLM_SUBJECT,
      OLLAMA_URL: 'https://nats2ollama.gis-master.ru',
      LLM_MODE: 'remote',
      LLM_LOCAL_MODEL: 'Qwen/Qwen3-1.7B-GGUF',
      LLM_REMOTE_MODEL: 'qwen3:30b',
      LLM_MODELS: '/app/models/llm',
      OLLAMA_MODEL_FILE: '',
      LLM_CONTEXT_SIZE: '8192'
  volume name: 'LLM_MODELS', target: '/app/models/llm'
end

# Python workflow runner. Used only when WORKFLOW_RUNTIME selects the python subjects.
Service :src_langgraph, image: webrtc_registry['langgraph'] do
  env STACK_SERVICE_NAME: 'src_langgraph',
      USER_ID: USER_ID,
      NATS_URL: NATS_URL,
      NATS_LLM_SUBJECT: NATS_LLM_SUBJECT,
      NATS_TOOLS_PREFIX: NATS_TOOLS_PREFIX,
      NATS_WORKFLOW_RUN_SUBJECT: 'nats.workflow.run.python',
      NATS_WORKFLOW_HEALTH_SUBJECT: 'nats.workflow.health.python',
      NATS_REQUEST_TIMEOUT_SECONDS: '120',
      MAX_CONCURRENCY: '8'
end

# Ruby workflow runner. Used only when WORKFLOW_RUNTIME selects the ruby subjects.
Service :src_langgraph_rb, image: webrtc_registry['langgraph-rb'] do
  env STACK_SERVICE_NAME: 'src_langgraph_rb',
      USER_ID: USER_ID,
      NATS_URL: NATS_URL,
      NATS_LLM_SUBJECT: NATS_LLM_SUBJECT,
      NATS_TOOLS_PREFIX: NATS_TOOLS_PREFIX,
      NATS_WORKFLOW_RUN_SUBJECT: 'nats.workflow.run.ruby',
      NATS_WORKFLOW_HEALTH_SUBJECT: 'nats.workflow.health.ruby',
      NATS_REQUEST_TIMEOUT_SECONDS: '120'

  command ['bundle', 'exec', 'ruby', './lib/src_langgraph_rb/runtime/service.rb']
end

# Ruby+Node workflow runner. This is the active path when WORKFLOW_RUNTIME=ruby_node.
Service :src_langgraph_rb_node, image: webrtc_registry['langgraph-rb-node'] do
  env STACK_SERVICE_NAME: 'src_langgraph_rb_node',
      USER_ID: USER_ID,
      NATS_URL: NATS_URL,
      NATS_LLM_SUBJECT: NATS_LLM_SUBJECT,
      NATS_TOOLS_PREFIX: NATS_TOOLS_PREFIX,
      NATS_WORKFLOW_RUN_SUBJECT: 'nats.workflow.run.ruby.node',
      NATS_WORKFLOW_HEALTH_SUBJECT: 'nats.workflow.health.ruby.node',
      NATS_REQUEST_TIMEOUT_SECONDS: '120'

  command ['bundle', 'exec', 'ruby', './lib/src_langgraph_rb_node/runtime/service.rb']
end

# Browser frontend for the voice chat app. Serves UI and talks to core/NATS.
Service :src_front, image: webrtc_registry['front'] do
  ingress host: HOST, port: 8000

  env FRONT_NATS_EVENTS_SUBJECT: "#{NATS_EVENTS_SUBJECT}#{USER_ID}",
      FRONT_NATS_AGENT_SUBJECT: "#{NATS_AGENT_SUBJECT}#{USER_ID}",
      FRONT_NATS_WS_UPSTREAM: 'web-rtc-komaroff_audio_nats',
      FRONT_NATS_USER: NATS_USER,
      FRONT_NATS_PASS: NATS_PASS,
      FRONT_NATS_CLIENT_NAME: 'src_front',
      FRONT_CORE_ORIGIN: 'http://web-rtc-komaroff_src_core:8000',
      COM_GITLAB_CI_PIPELINE_IID: ENV['CI_PIPELINE_ID'].to_s
end

# Persistent PostgreSQL for MCP / workflow / application state.
Service :src_postgres, image: webrtc_registry['postgres'] do
  env POSTGRES_DB: POSTGRES_DB,
      POSTGRES_USER: POSTGRES_USER,
      POSTGRES_PASSWORD: POSTGRES_PASSWORD

  volume target: '/var/lib/postgresql/data'

  # оставляем твой параметр
  command ['postgres', '--wal_level=logical']

  ingress host_sni: "db.#{HOST}", port: 5432, entrypoints: 'postgres'
end



# GisMaster client
# to.inference.ollama.requests.?? <- json (Ollama Rest API) reply: inference.ollama.responses.INBOX.12312312321
# from.inference.ollama.responses.<id> ?? -> json (Ollama Rest API)

# to.inference.whisper.stream.<sid> <- chunks
# from.inference.whisper.text.<sid> -> text

# Browser-facing NATS gateway: exposes /ws and bridges local websocket clients
# into the inference account through a leafnode.
Service :audio_nats, image: 'nats:2.11.6-scratch' do
  ingress host: HOST, path: '/ws', path_sub: ['^/ws(.*)', '$1'], port: 9222

  command ['-c', '/nats.conf']
  config target: '/nats.conf', file_content: <<~CONF
    jetstream: false
    websocket: { listen: 0.0.0.0:9222, no_tls: true, compression: true }

    debug: true
    trace: true

    accounts: {
      local: {
        users: [
          { user: #{NATS_USER}, password: #{NATS_PASS}, allowed_connection_types: [ STANDARD, WEBSOCKET ] }
        ]
        exports: [
          { stream: "to.inference.>" }
        ]
        imports: [
          { stream: { account: inference, subject: "inference.>" }, to: "from.inference.>" }
          { service: { account: inference, subject: "$JS.dinf.API.>" }, to: "JS.INF.API.>" }
        ]
      }

      inference: {
        exports: [
          { stream: "inference.>" }
          { service: "$JS.dinf.API.>" }
        ]
        imports: [
          { stream: { account: local, subject: "to.inference.>" }, to: "inference.>" }
        ]
        jetstream: enabled
      }
    }

    leafnodes: {
        remotes: [
            # Inference
            {
                # url: nats://h100.local:37422,
                url: nats://192.168.28.134:37422,
                account: inference,
                nkey: SUAI355NRU346GCGPBOIMVUHYPJWEWS3OI6F4NMJHWS4R6APIZ52PL4YJM
            }
        ]
    }
  CONF
end


# Shared guard used by all Whisper upload/transcription/diarization pages. The UI
# polls it, and each backend runner also enforces it before model work starts.
Service :whisper_file_job_lock, image: webrtc_registry['voice-chat/stt_whisper_to_nats'] do
  env HOST_SERVING_HOST: '0.0.0.0',
      HOST_SERVING_PORT: '8091',
      FILE_JOB_LOCK_TTL_S: '7200',
      STACK_SERVICE_NAME: 'whisper_file_job_lock'

  entrypoint 'python -m src.webui.job_lock_server'
end

# Plain transcription service. Same binary as py_faster_whisper_diarize, but this
# deployment serves /whisper-trasncription, keeps the live stream bridge on, and disables diarization.
Service :py_faster_whisper, image: webrtc_registry['voice-chat/stt_whisper_to_nats'] do
  ingress host: HOST, path: '/whisper-trasncription', port: 8090
  ingress host: HOST, path: '/whisper-trascripton', port: 8090
  ingress host: HOST, path: '/whisper-transcription', port: 8090
  ingress host: HOST, path: '/whisper', port: 8090

  env WHISPER_FILE_JOB_ENV.merge(WHISPER_WEBUI_ENV).merge(WHISPER_STREAM_ENV).merge(
        DIARIZATION_ENABLED: '0',
        WEBUI_BASE_PATH: '/whisper-trasncription',
        WEBUI_PAGE_MODE: 'transcribe_only',
        STACK_SERVICE_NAME: 'stt_whisper_to_nats'
      )

  entrypoint 'python -m src.stt_whisper_to_nats'
end

# Combined file ASR + speaker separation service. Same binary as py_faster_whisper,
# but this deployment serves /whisper-diarization, runs file-mode only, and enables diarization.
Service :py_faster_whisper_diarize, image: webrtc_registry['voice-chat/stt_whisper_to_nats'] do
  ingress host: HOST, path: '/whisper-diarization', port: 8090
  ingress host: HOST, path: '/whisper-diarize', port: 8090

  env WHISPER_FILE_JOB_ENV.merge(WHISPER_WEBUI_ENV).merge(WHISPER_DIARIZATION_EVENT_ENV).merge(WHISPER_DIARIZATION_ENV).merge(
        STREAM_BRIDGE_ENABLED: '0',
        WEBUI_BASE_PATH: '/whisper-diarization',
        WEBUI_PAGE_MODE: 'diarize',
        WEBUI_HOME_LINK_PATH: '/whisper-trasncription',
        STACK_SERVICE_NAME: 'stt_whisper_to_nats_diarize'
      )

  entrypoint 'python -m src.stt_whisper_to_nats'
end

# Staged file ASR + speaker separation analysis service. Same binary as the other
# py_faster_whisper deployments, but this deployment serves /whisper-staged and
# exposes isolated Transcribe / Diarize / Combine steps on cached artifacts.
Service :py_faster_whisper_staged, image: webrtc_registry['voice-chat/stt_whisper_to_nats'] do
  ingress host: HOST, path: '/whisper-staged', port: 8090

  env WHISPER_FILE_JOB_ENV.merge(WHISPER_WEBUI_ENV).merge(WHISPER_DIARIZATION_EVENT_ENV).merge(WHISPER_DIARIZATION_ENV).merge(
        STREAM_BRIDGE_ENABLED: '0',
        WEBUI_BASE_PATH: '/whisper-staged',
        WEBUI_PAGE_MODE: 'staged',
        WEBUI_HOME_LINK_PATH: '/whisper-diarization',
        STACK_SERVICE_NAME: 'stt_whisper_to_nats_staged'
      )

  entrypoint 'python -m src.stt_whisper_to_nats'
end

# Benchmark UI for non-streaming transcription + diarization experiments. It
# keeps results separate from /whisper-staged while using the same deployed image.
Service :py_faster_whisper_bench, image: webrtc_registry['voice-chat/stt_whisper_to_nats'] do
  ingress host: HOST, path: '/whisper-bench', port: 8090

  env WHISPER_FILE_JOB_ENV.merge(WHISPER_WEBUI_ENV).merge(WHISPER_DIARIZATION_EVENT_ENV).merge(WHISPER_DIARIZATION_ENV).merge(
        STREAM_BRIDGE_ENABLED: '0',
        WEBUI_BASE_PATH: '/whisper-bench',
        WEBUI_PAGE_MODE: 'bench',
        WEBUI_HOME_LINK_PATH: '/whisper-staged',
        FILE_JOB_STORAGE_DIR: '/tmp/whisper-bench-jobs',
        BENCH_CONFIGS_JSON: WHISPER_BENCH_CONFIGS_JSON,
        STACK_SERVICE_NAME: 'stt_whisper_to_nats_bench'
      )

  volume name: 'whisper_bench_jobs', target: '/tmp/whisper-bench-jobs'
  entrypoint 'python -m src.stt_whisper_to_nats'
end

# Main page for all tried non-streaming transcription + diarization approaches.
# The case pages under /whisper-summary/cases/<case-id> reuse the same
# runner and result store as /whisper-bench, so measured stats stay comparable.
Service :py_faster_whisper_summary, image: webrtc_registry['voice-chat/stt_whisper_to_nats'] do
  ingress host: HOST, path: '/whisper-summary', port: 8090

  env WHISPER_FILE_JOB_ENV.merge(WHISPER_WEBUI_ENV).merge(WHISPER_DIARIZATION_EVENT_ENV).merge(WHISPER_DIARIZATION_ENV).merge(
        STREAM_BRIDGE_ENABLED: '0',
        WEBUI_BASE_PATH: '/whisper-summary',
        WEBUI_PAGE_MODE: 'summary',
        WEBUI_HOME_LINK_PATH: '/whisper-summary',
        FILE_JOB_STORAGE_DIR: '/tmp/whisper-bench-jobs',
        BENCH_CONFIGS_JSON: WHISPER_BENCH_CONFIGS_JSON,
        STACK_SERVICE_NAME: 'stt_whisper_to_nats_summary'
      )

  volume name: 'whisper_bench_jobs', target: '/tmp/whisper-bench-jobs'
  entrypoint 'python -m src.stt_whisper_to_nats'
end



# Debug shell for manual NATS inspection inside the stack.
Service :nats_box, image: 'natsio/nats-box' do
  env NATS_URL: NATS_URL
  entrypoint 'sh -c "sleep infinity"'
end

# Admin UI for inspecting NATS subjects/connections/messages.
Service :nats_ui, image: registry['nats-ui/main:latest'], ports: 7000 do
  ingress host: "ns.#{HOST}", basic_auth: 'admin:admin:i7hdbc9g'
  env NATS_URL: NATS_URL
end

# Admin UI for browsing the PostgreSQL database.
Service :pgweb_mcp, image: 'sosedoff/pgweb:0.17.0', env: { PGWEB_DATABASE_URL: DATABASE_URL },
        ingress: { host: "pgweb.#{HOST}", port: 8081, basic_auth: 'admin:admin:i7123hdbc9g' }
