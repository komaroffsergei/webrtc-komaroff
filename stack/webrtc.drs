Options name: 'web-rtc-komaroff'

NATS_URL = "nats://web-rtc-komaroff_audio_nats:4222"
PublishPorts back: [ { target: 19303, published: 19303, protocol: 'udp', mode: 'host'}]


Service :back,  image: 'builder-registry.builder.giscloud.ru/webrtc-server-komaroff-back/main', ports: 8000,
        ingress: { host: 'webrtc-komaroff.*' } do
  env NATS_URL: NATS_URL,
      NATS_FRAMES_SUBJECT: 'nats.frames',
      NATS_LOGS_SUBJECT: 'nats.logs'
end

Service :whisper, image: 'builder-registry.builder.giscloud.ru/webrtc-server-komaroff-whisper/main', ports: 9000,
        ingress: { host: 'webrtc-komaroff-whisper.*' } do
  env NATS_URL: NATS_URL,
      NATS_FRAMES_SUBJECT: 'nats.frames',
      NATS_LOGS_SUBJECT: 'nats.logs'
      WHISPER_MODEL_ID: 'Systran/faster-whisper-small',
   volume name: 'MODELS_DIR', target: '/app/models'
end

Service :whisper_ruby, image: 'builder-registry.builder.giscloud.ru/webrtc-server-komaroff-whisper-ruby/main', ports: 7000,
        ingress: { host: 'webrtc-komaroff-whisper-ruby.*' } do
  env NATS_URL: NATS_URL,
      NATS_FRAMES_SUBJECT: 'nats.frames',
      NATS_LOGS_SUBJECT: 'nats.logs'
      WHISPER_MODEL_URL: 'https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin',
      WHISPER_MODEL_SHA1: '55356645c2b361a969dfd0ef2c5a50d530afd8d5'
      PORT: 7000
   volume name: 'MODELS_DIR', target: '/app/models'
end

Service :audio_nats, image: 'nats:2.11.6-scratch'

Service :nats_box, image: 'natsio/nats-box' do
  env NATS_URL: NATS_URL
  entrypoint "sh -c \"sleep infinity\""
end
