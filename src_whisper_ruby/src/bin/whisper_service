#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/whisper_ruby/service"

service = WhisperRuby::Service.new

begin
  service.start
rescue StandardError => e
  warn "[whisper_ruby] failed to start: #{e}"
  exit 1
end

stop = proc do |signal|
  warn "[whisper_ruby] received #{signal}, shutting down"
  service.stop
  exit 0
end

Signal.trap("INT") { stop.call("INT") }
Signal.trap("TERM") { stop.call("TERM") }

sleep
