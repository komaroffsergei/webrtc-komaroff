STACK_SERVICE_NAME=src_whisper_ruby
NATS_URL=nats://127.0.0.1:4222
NATS_WHISPER_SUBJECT=whisper.transcription
NATS_LOGS_SUBJECT=whisper.logs
WHISPER_MODEL=../models/ggml-medium.bin
WHISPER_MODEL_NAME=medium
WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-medium.bin
WHISPER_MODELS_DIR=../models
WHISPER_LANGUAGE=ru
WHISPER_SAMPLE_RATE=16000
WHISPER_WORKERS=2
WHISPER_MAX_QUEUE=8
WHISPER_VAD_MODEL_PATH=../models/ggml-silero-v5.1.2.bin
WHISPER_VAD_MODEL_NAME=silero-v5.1.2
WHISPER_VAD_THRESHOLD=0.5
WHISPER_VAD_MIN_SPEECH_MS=250
WHISPER_VAD_MIN_SILENCE_MS=100
WHISPER_VAD_MAX_SPEECH_MS=30000
WHISPER_VAD_SPEECH_PAD_MS=30
WHISPER_FORCE_DOWNLOAD=false
WHISPER_TRANSLATE=false
WHISPER_THREADS=4
WHISPER_TEMPERATURE=0.2
WHISPER_TEMPERATURE_INC=0.2
