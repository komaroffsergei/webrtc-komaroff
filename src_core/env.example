USER_ID=user123
STACK_SERVICE_NAME=src_core
CORE_PORT=8000
CORE_HOST=localhost


NATS_URL=nats://localhost:4222
NATS_EVENTS_SUBJECT=nats.events.
NATS_AGENT_SUBJECT=nats.agent.
NATS_REQUEST_TIMEOUT=600

# If running src_core on the host while api-gateway is in Docker, use host port 8101.
API_URL=http://127.0.0.1:8101/api

# If src_core is already running in Docker and occupies port 8000, set a free port here.
# CORE_PORT=8002


ASR_MODELS=/app/models/asr
ASR_MODEL_ID=Systran/faster-whisper-small

